# ==============================================================================
# CONFIGURACIÓN DE ALMACENAMIENTO Y MODELOS (100% EN DISCO D:)
# ==============================================================================
# Todos los modelos pesados (Hunyuan3D-2, rembg, torch) se almacenan en D:\
HF_HOME=D:\AI_Models\huggingface
HUGGINGFACE_HUB_CACHE=D:\AI_Models\huggingface\hub
TORCH_HOME=D:\AI_Models\torch
U2NET_HOME=D:\AI_Models\u2net
HY3DGEN_MODELS=D:\AI_Models
PIP_CACHE_DIR=D:\AI_Models\pip_cache
TEMP=D:\AI_Models\temp
TMP=D:\AI_Models\temp

# Rutas de Kaboomi Party
KABOOMI_DIR=..\Games\kaboomi-party

# Configuración de Hunyuan3D-2 para GPU 16GB VRAM
LOW_VRAM=True
USE_FP16=True
DIT_SUBFOLDER=hunyuan3d-dit-v2-0-turbo
PAINT_SUBFOLDER=hunyuan3d-paint-v2-0
DEFAULT_FACES=4000

# Memoria: un solo modelo en la GPU a la vez. Antes de cargar cada modelo se valida la RAM/VRAM libre.
# KEEP_MODELS_IN_RAM=1 conserva en RAM el modelo inactivo (si sobra RAM) para no releerlo del disco; 0 = liberar siempre.
KEEP_MODELS_IN_RAM=1
# RAM que siempre se deja libre para Windows y otros programas (GB)
RAM_SAFETY_MARGIN_GB=2
# Si tras usar un modelo quedan menos GB libres que esto, se libera en vez de conservarlo
RAM_PARK_MIN_FREE_GB=4

# GPU fija sin menu al arrancar (indice de nvidia-smi o cpu). Vacio = preguntar si hay 2+ tarjetas
# STUDIO_GPU=0

# Carga del modelo de forma (misma calidad en todos los modos):
#   auto   = todo directo a la GPU si cabe (~6 GB VRAM); si no, por partes desde el disco (recomendado)
#   full   = condicionador + DiT + VAE en la GPU (RAM ~0, el mas rapido)
#   stream = por partes: cada componente se lee del disco a la GPU en su etapa (RAM ~0, VRAM ~3 GB)
#   staged = los 3 en RAM y suben a la GPU de uno en uno (usa ~4.6 GB de RAM)
SHAPE_LOAD_MODE=auto

# Profundidad mejorada: si el modelo sale con menos fondo que esto (respecto al alto), se refuerza.
# 0.08 solo rescata lo que sale casi de papel (monedas/placas miden ~0.08-0.12 de verdad);
# para personajes que salen tipo cartón usa ~0.30
DEPTH_MIN_RATIO=0.08
# Normal map: pasadas de filtrado de las normales HD (quita los bultos del generador; más = más liso)
# e intensidad del relieve (0-1)
NORMAL_DENOISE_ITERATIONS=10
NORMAL_MAP_STRENGTH=1.0
# Profundidad mejorada: semillas que se prueban (gana la que más se parece a la silueta; cada una suma una pasada del DiT)
DEPTH_SEED_CANDIDATES=3
# Máxima calidad: guía del modelo completo (más alto = más fiel a la imagen, demasiado alto = artefactos)
MAX_QUALITY_GUIDANCE=6.0
# Normal map del detalle HD cuando el modelo no lleva textura (con textura usa el tamaño de la textura)
NORMAL_MAP_SIZE=1024

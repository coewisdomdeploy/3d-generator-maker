# ==============================================================================
# CONFIGURACIÓN DE ALMACENAMIENTO Y MODELOS (100% EN DISCO D:)
# ==============================================================================
# Todos los modelos pesados (Hunyuan3D-2, rembg, torch) se almacenan en D:\
HF_HOME=D:\AI_Models\huggingface
HUGGINGFACE_HUB_CACHE=D:\AI_Models\huggingface\hub
TORCH_HOME=D:\AI_Models\torch
U2NET_HOME=D:\AI_Models\u2net
HY3DGEN_MODELS=D:\AI_Models
PIP_CACHE_DIR=D:\AI_Models\pip_cache
TEMP=D:\AI_Models\temp
TMP=D:\AI_Models\temp

# Rutas de Kaboomi Party
KABOOMI_DIR=..\Games\kaboomi-party

# Configuración de Hunyuan3D-2 para GPU 16GB VRAM
LOW_VRAM=True
USE_FP16=True
DIT_SUBFOLDER=hunyuan3d-dit-v2-0-turbo
PAINT_SUBFOLDER=hunyuan3d-paint-v2-0
DEFAULT_FACES=4000

# Memoria: un solo modelo en la GPU a la vez. Antes de cargar cada modelo se valida la RAM/VRAM libre.
# KEEP_MODELS_IN_RAM=1 conserva en RAM el modelo inactivo (si sobra RAM) para no releerlo del disco; 0 = liberar siempre.
KEEP_MODELS_IN_RAM=1
# RAM que siempre se deja libre para Windows y otros programas (GB)
RAM_SAFETY_MARGIN_GB=2
# Si tras usar un modelo quedan menos GB libres que esto, se libera en vez de conservarlo
RAM_PARK_MIN_FREE_GB=4

# GPU fija sin menu al arrancar (indice de nvidia-smi o cpu). Vacio = preguntar si hay 2+ tarjetas
# STUDIO_GPU=0
